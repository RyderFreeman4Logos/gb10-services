# DFlash profile selection and capacity history: docs/deployment/AGENTS.md.
[Unit]
# AEON image release: 2026-07-27-v0.26.0; immutable digest: sha256:1aa47363e4c9cfa0a85411c669d39b7f9fa3adb3e735ef1ca5760be3044dacd7
Description=vLLM AEON-7 Qwen3.6-27B DFlash n=10 (profile-selected, v0.26.0)
# Independent of embedding/reranker so text can restart alone (no HTTP poll).
After=network.target
Conflicts=vllm-aeon-27b.service vllm-aeon-27b-dflash-v2.service vllm-aeon-27b-dflash-v3.service vllm-aeon-27b-nvfp4kv.service vllm-aeon-27b-nvfp4kv-test.service vllm-aeon-27b-nvfp4kv-lowmem.service vllm-aeon-27b-nvfp4kv-plus10g.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
UMask=0077
Environment=DOCKER_HOST=unix:///run/user/1001/docker.sock
Environment=HF_HUB_OFFLINE=1
Environment=GB10_CGROUP_REGISTRATION_PATH=%t/gb10-memory-guardian/text-cgroup.v1
Environment=GB10_CONTAINER_CIDFILE=%t/gb10-memory-guardian/aeon-text.cid
Environment=AEON_URL=http://100.105.4.92:18010
EnvironmentFile=/home/obj/.config/gb10/aeon-dflash-profiles/active.env
# Prefer killing text before reranker under host OOM (reranker uses 500).
OOMScoreAdjust=800
# NO --kv-cache-memory-bytes: AEON confirmed pinning KV bypasses UMA guard
# (#46932); AUTO sizing lets UMA clamps bound the pool from actual free memory.
# Manual lifecycle changes must use gb10_lifecycle.sh; the text helper routes through it.
MemoryMax=256M
# Recover from any stop cause (crash, OOM kill, guardian cgroup.kill).
# Manual `systemctl --user stop` is NOT restarted because systemd treats
# an explicit stop as a clean deactivation, not a failure.
Restart=always
RestartSec=30
TimeoutStartSec=3000
TimeoutStopSec=60

ExecCondition=/usr/bin/env -i HOME=/home/obj PATH=/usr/bin:/bin LC_ALL=C DOCKER_HOST=unix:///run/user/1001/docker.sock AEON_GPU_MEMORY_UTILIZATION=${AEON_GPU_MEMORY_UTILIZATION} /usr/bin/bash --noprofile --norc /home/obj/.local/bin/gb10_verify_vllm_no_swap.sh --unit /home/obj/.config/systemd/user/vllm-aeon-27b-dflash.service
ExecStartPre=/usr/bin/install -d -m 0700 %t/gb10-memory-guardian
ExecStartPre=/usr/bin/install -d -m 0700 /home/obj/.cache/vllm-compile/aeon-qwen36-v0260-1aa473
ExecStartPre=/usr/bin/env -i HOME=/home/obj PATH=/usr/bin:/bin LC_ALL=C DOCKER_HOST=unix:///run/user/1001/docker.sock /usr/bin/bash --noprofile --norc /home/obj/.local/bin/gb10_verify_vllm_no_swap.sh --cleanup --container vllm-aeon-27b-dflash-n12 --container vllm-aeon-27b-dflash-hikv --container vllm-aeon-27b-dflash --cidfile %t/gb10-memory-guardian/aeon-text.cid
ExecStartPre=/usr/bin/rm -f %t/gb10-memory-guardian/text-cgroup.v1
ExecStart=/usr/bin/env -i HOME=/home/obj PATH=/usr/bin:/bin LC_ALL=C DOCKER_HOST=unix:///run/user/1001/docker.sock /usr/bin/docker run --rm --cidfile=%t/gb10-memory-guardian/aeon-text.cid --name vllm-aeon-27b-dflash \
  --cgroup-parent app.slice \
  --gpus all --ipc host \
  -p 100.105.4.92:18010:8000 \
  -v /home/obj/.cache/huggingface/hub/models--AEON-7--Qwen3.6-27B-AEON-Ultimate-Uncensored-Multimodal-NVFP4-MTP-XS:/models/aeon-cache:ro \
  -v /home/obj/.cache/huggingface/hub/models--z-lab--Qwen3.6-27B-DFlash:/models/dflash-cache:ro \
  -v /home/obj/.cache/vllm-compile/aeon-qwen36-v0260-1aa473:/var/cache/vllm/aeon-qwen36-v0260 \
  -v /home/obj/scripts/aeon_hang_guard.py:/opt/hang_guard/aeon_hang_guard.py:ro \
  -v /home/obj/scripts/aeon_vllm_wrapper.py:/opt/hang_guard/aeon_vllm_wrapper.py:ro \
  -e HF_HUB_OFFLINE=1 \
  -e MAX_JOBS=1 \
  -e CMAKE_BUILD_PARALLEL_LEVEL=1 \
  -e PYTHONPATH=/opt/hang_guard \
  -e AEON_DEFAULT_THINKING_TOKEN_BUDGET=32768 \
  -e AEON_THINKING_BUDGET_GUARD=0 \
  --memory-swappiness 0 \
  --memory 128g \
  --memory-swap 128g \
  --oom-score-adj 800 \
  --entrypoint python3 \
  ghcr.io/aeon-7/aeon-vllm-ultimate@sha256:1aa47363e4c9cfa0a85411c669d39b7f9fa3adb3e735ef1ca5760be3044dacd7 \
  /opt/hang_guard/aeon_vllm_wrapper.py serve \
    /models/aeon-cache/snapshots/6394b93fa092dcbfbf09e952f56f30337509d17c \
    --host 0.0.0.0 --port 8000 \
    --served-model-name "aeon-ultimate" "qwen3.6-27b-decensor-by-aeon" "qwen3.6-27b-decensored" \
    --quantization modelopt \
    --kv-cache-dtype fp8_e4m3 \
    --attention-backend TRITON_ATTN \
    --mamba-cache-dtype float32 \
    --max-model-len 262144 \
    --max-num-seqs 16 \
    --max-num-batched-tokens 4096 \
    --max-num-partial-prefills 1 \
    --max-long-partial-prefills 1 \
    --enable-prefix-caching \
    --gpu-memory-utilization ${AEON_GPU_MEMORY_UTILIZATION} \
    --enable-chunked-prefill \
    --scheduler-reserve-full-isl \
    --compilation-config "{\"mode\":3,\"cudagraph_mode\":\"FULL_DECODE_ONLY\",\"cudagraph_num_of_warmups\":0,\"cache_dir\":\"/var/cache/vllm/aeon-qwen36-v0260\"}" \
    --jit-monitor-mode warn \
    --max-logprobs 20 \
    --speculative-config "{\"method\":\"dflash\",\"model\":\"/models/dflash-cache/snapshots/0919688658996800f86b895034249700e9481106\",\"num_speculative_tokens\":10,\"attention_backend\":\"TRITON_ATTN\"}" \
    --reasoning-parser qwen3 \
    --enable-auto-tool-choice \
    --tool-call-parser qwen3_coder \
    --default-chat-template-kwargs "{\"enable_thinking\":false}" \
    --override-generation-config "{\"temperature\":0.6,\"top_p\":0.95,\"top_k\":20}" \
    --trust-remote-code
# Multimodal retained: no --language-model-only
# Bind this exact Docker scope's no-swap state into the user manager, then verify it.
ExecStartPost=/usr/bin/env -i HOME=/home/obj PATH=/usr/bin:/bin LC_ALL=C DOCKER_HOST=unix:///run/user/1001/docker.sock AEON_GPU_MEMORY_UTILIZATION=${AEON_GPU_MEMORY_UTILIZATION} /usr/bin/bash --noprofile --norc /home/obj/.local/bin/gb10_verify_vllm_no_swap.sh --bind-runtime-swap-max --unit /home/obj/.config/systemd/user/vllm-aeon-27b-dflash.service --container vllm-aeon-27b-dflash
ExecStartPost=/usr/bin/env -i HOME=/home/obj PATH=/usr/bin:/bin LC_ALL=C DOCKER_HOST=unix:///run/user/1001/docker.sock AEON_GPU_MEMORY_UTILIZATION=${AEON_GPU_MEMORY_UTILIZATION} /usr/bin/bash --noprofile --norc /home/obj/.local/bin/gb10_verify_vllm_no_swap.sh --unit /home/obj/.config/systemd/user/vllm-aeon-27b-dflash.service --container vllm-aeon-27b-dflash
# Publish the exact Docker cgroup for llm-guard-proxy's integrated guardian.
ExecStartPost=/usr/bin/env -i HOME=/home/obj PATH=/usr/bin:/bin LC_ALL=C XDG_RUNTIME_DIR=%t GB10_CONTAINER_CIDFILE=%t/gb10-memory-guardian/aeon-text.cid GB10_CGROUP_REGISTRATION_PATH=%t/gb10-memory-guardian/text-cgroup.v1 /usr/bin/bash --noprofile --norc /home/obj/.local/bin/llm_guard_proxy_publish_cgroup_registration.sh
# Raw :18010 readiness (defaults target Guard :18009).
ExecStartPost=/usr/bin/env -i HOME=/home/obj PATH=/usr/bin:/bin LC_ALL=C /usr/bin/bash --noprofile --norc /home/obj/.local/bin/gb10_service_ready.sh chat http://100.105.4.92:18010 aeon-ultimate --deadline 2800
ExecStop=/usr/bin/env -i HOME=/home/obj PATH=/usr/bin:/bin LC_ALL=C DOCKER_HOST=unix:///run/user/1001/docker.sock /usr/bin/bash --noprofile --norc /home/obj/.local/bin/gb10_verify_vllm_no_swap.sh --cleanup --container vllm-aeon-27b-dflash-n12 --container vllm-aeon-27b-dflash-hikv --container vllm-aeon-27b-dflash --cidfile %t/gb10-memory-guardian/aeon-text.cid
ExecStopPost=/usr/bin/env -i HOME=/home/obj PATH=/usr/bin:/bin LC_ALL=C DOCKER_HOST=unix:///run/user/1001/docker.sock /usr/bin/bash --noprofile --norc /home/obj/.local/bin/gb10_verify_vllm_no_swap.sh --cleanup --container vllm-aeon-27b-dflash-n12 --container vllm-aeon-27b-dflash-hikv --container vllm-aeon-27b-dflash --cidfile %t/gb10-memory-guardian/aeon-text.cid
ExecStopPost=/usr/bin/rm -f %t/gb10-memory-guardian/text-cgroup.v1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
