# sparkDash host-process env — loopback dashboard, host sysfs, bounded polls.
# No secrets. Do not bind 0.0.0.0. Do not set SPARKDASH_ALLOW_OPEN_REMOTE=1 with a public bind.

BIND_HOST=127.0.0.1
PORT=20080
NODE_ENV=production
SPARKDASH_ALLOW_OPEN_REMOTE=0

# Host collectors (not Docker /host/* mounts)
HOST_PROC_PATH=/proc
HOST_SYS_PATH=/sys
HOST_ROOT_PATH=/

# LLM default unused when sparks.json llmPorts is set
LLM_PORT=18010

# Bounded polling — gentler than upstream 1–2s defaults
POLL_INTERVAL_GPU=5000
POLL_INTERVAL_CPU=5000
POLL_INTERVAL_NETWORK=5000
POLL_INTERVAL_STORAGE=30000
POLL_INTERVAL_LLM=5000
POLL_INTERVAL_BANDWIDTH=5000
POLL_INTERVAL_LIVENESS=15000
POLL_INTERVAL_NVERR=120000
POLL_INTERVAL_COMFY=60000
POLL_INTERVAL_TAILSCALE=60000
POLL_INTERVAL_HERMES=3600000

# Config lives in the checkout (gitignored runtime files)
SPARKS_JSON_PATH=/home/obj/src/sparkDash/config/sparks.json
